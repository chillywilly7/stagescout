{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "booking_request_id": {
      "type": "string",
      "description": "Reference to booking request"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of message sender"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "customer",
        "scout"
      ],
      "description": "Who sent the message"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Message read status"
    }
  },
  "required": [
    "booking_request_id",
    "sender_email",
    "sender_type",
    "message"
  ]
}