
{
  "name": "Review",
  "type": "object",
  "properties": {
    "tasker_id": {
      "type": "string",
      "description": "ID of the tasker being reviewed"
    },
    "booking_id": {
      "type": "string",
      "description": "ID of the related booking"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "rating": {
      "type": "number",
      "description": "Rating from 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Review text"
    },
    "event_type": {
      "type": "string",
      "description": "Type of event for context"
    }
  },
  "required": [
    "tasker_id",
    "rating"
  ]
}

