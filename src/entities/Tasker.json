{
  "name": "Tasker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the service provider"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "profile_image": {
      "type": "string",
      "description": "URL to profile photo"
    },
    "service_category": {
      "type": "string",
      "enum": [
        "dj",
        "audio_rental",
        "lighting",
        "photographer",
        "live_music"
      ],
      "description": "Primary service category"
    },
    "bio": {
      "type": "string",
      "description": "About the tasker"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Base hourly rate in USD"
    },
    "daily_rate": {
      "type": "number",
      "description": "Full day rate in USD"
    },
    "zip_code": {
      "type": "string",
      "description": "Service area zip code"
    },
    "service_radius_miles": {
      "type": "number",
      "description": "How far they travel for gigs"
    },
    "portfolio_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery of work photos"
    },
    "equipment_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of equipment they provide"
    },
    "average_rating": {
      "type": "number",
      "description": "Average review rating (1-5)"
    },
    "total_reviews": {
      "type": "number",
      "description": "Total number of reviews"
    },
    "years_experience": {
      "type": "number",
      "description": "Years of professional experience"
    },
    "is_verified": {
      "type": "boolean",
      "description": "Whether the tasker is verified"
    }
  },
  "required": [
    "name",
    "service_category",
    "hourly_rate",
    "zip_code"
  ]
}

