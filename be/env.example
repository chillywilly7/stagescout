# StagePros Backend Configuration
# Copy this file to .env and fill in your values

# ==================== Security ====================
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set in development, a random key is generated on each restart.
SECRET_KEY=

# Set to "production" when deploying to a public domain (enables secure cookies, strict checks)
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (used for CORS)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== Email ====================
# Gmail SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# For Gmail, you need to use an "App Password" (not your regular password)
# Steps to create an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to "App passwords" (search for it in your Google Account settings)
# 4. Create a new App Password for "Mail" on "Mac"
# 5. Copy the 16-character password and use it as SMTP_PASSWORD

# Alternative: Use other email providers
# Outlook/Hotmail:
#   SMTP_SERVER=smtp.office365.com
#   SMTP_PORT=587

# Yahoo:
#   SMTP_SERVER=smtp.mail.yahoo.com
#   SMTP_PORT=587
