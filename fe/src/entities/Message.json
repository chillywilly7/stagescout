
{
  "name": "Message",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "ID of the related booking"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of the sender"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of the recipient"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read"
    }
  },
  "required": [
    "booking_id",
    "sender_email",
    "content"
  ]
}

